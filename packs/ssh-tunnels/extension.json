{
  "id": "dev.sshremote.ssh-tunnels",
  "name": "SSH tunnels",
  "version": "1.2.0",
  "api": 2,
  "description": "Port forwards through your SSH hosts: make local, remote and SOCKS tunnels in a panel and keep them, or use those of ~/.ssh/config; start, stop, start with the app, and see how many run.",
  "activation": "startup",
  "permissions": [
    "native",
    "workspace.open"
  ],
  "programs": {
    "windows-x86_64": "ssh-tunnels.exe",
    "linux-x86_64": "ssh-tunnels"
  },
  "contributes": {
    "commands": [
      {
        "id": "show",
        "label": "Show the tunnels"
      },
      {
        "id": "forward",
        "label": "Forward a port"
      },
      {
        "id": "stop_all",
        "label": "Stop every tunnel"
      }
    ]
  }
}
